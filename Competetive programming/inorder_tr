#include<bits/stdc++.h>
using namespace std;
struct node{ //creating node here...
    int data;
    node *left, *right;
}*root = NULL;

void inorder(node *root){
    if(root == NULL){
        return;
    }
    inorder(root -> left);
    cout<<root -> data<<" ";
    inorder(root -> right);
}

void inorder_i(node *root){
    stack<node*> s;
    while((root != NULL) || (!s.empty())){
        while(root!=NULL){
            s.push(root);
            root = root ->left;
        }
            root = s.top();
            s.pop();
            cout<<root -> data<<" ";
            root = root -> right;
    }
}

